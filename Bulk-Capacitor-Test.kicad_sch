	(text_box "Moco bulk capacitance is 270uF, uses 48 22uF ceramic capacitors rated for 100VDC.\nEqulivalent capacitance = 24 * (1/22uF + 1/22uF)^-1 = 264uF\nEach capacitor needs to be rated for ideal 2x the voltage across each. \nEach capacitor is in series with another of equal capacitance, therefore each cap has 60VDC across it which is acceptable given a rating of 100VDC.\nHas to be ceramic caps as opposed to electrolytic because Moco requires low ESR."
		(exclude_from_sim no)
		(at 43.18 176.53 0)
		(size 86.36 13.97)
		(stroke
			(width 0)
			(type default)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "4c194216-90d3-443d-ac7f-12c0895ebe6e")
	)
	(text_box "MPPT bulk capacitance is 440uF\n4, 100uF caps in parallel = 440uF equivalent capacitance"
		(exclude_from_sim no)
		(at 195.58 111.76 0)
		(size 59.69 5.08)
		(stroke
			(width 0)
			(type default)
		)
